#!/usr/bin/env python3

import json
import os
import re
import sys
import time
from pathlib import Path

side = sys.argv[1].upper() if len(sys.argv) > 1 else "W"

if side == "W":
    logdir = Path("Experiment/logs/final-opt")
else:
    logdir = Path("Experiment/logs/copilot-final-v2")

keydir = Path.home() / ".sqa-keys"
statefile = Path("Experiment/runtime/pool-supervisor-state.json")

try:
    state = json.loads(statefile.read_text())
except Exception:
    state = {"cooldown": {}}

cooldowns = state.get("cooldown", {})
now = time.time()

accounts = []

for f in keydir.glob(f"{side}[0-9]*.key"):
    name = f.stem
    if re.fullmatch(rf"{side}\d+", name):
        accounts.append(name)

accounts.sort(key=lambda x: int(re.search(r"\d+", x).group()))

active = []
standby = []
cooldown = []

for worker in accounts:
    pidfile = logdir / f"{worker}.pid"
    pid = 0

    try:
        raw = pidfile.read_text()
        digits = re.sub(r"\D", "", raw)
        pid = int(digits) if digits else 0
    except Exception:
        pass

    alive = pid > 0 and Path(f"/proc/{pid}").exists()

    if alive:
        active.append(worker)
        continue

    until = cooldowns.get(worker, 0)

    if until > now:
        mins = max(1, int((until - now + 59) // 60))
        cooldown.append(f"{worker}({mins}m)")
    else:
        standby.append(worker)

print()
print("=" * 82)
print(f"{'CHATGPT / TERRA' if side == 'W' else 'COPILOT / DEEPSEEK'} ACCOUNT POOL")
print("=" * 82)

print(
    f"ACTIVE   ({len(active):2}) : "
    + (" ".join(active) if active else "-")
)

print(
    f"STANDBY  ({len(standby):2}) : "
    + (" ".join(standby) if standby else "-")
)

print(
    f"COOLDOWN ({len(cooldown):2}) : "
    + (" ".join(cooldown) if cooldown else "-")
)
