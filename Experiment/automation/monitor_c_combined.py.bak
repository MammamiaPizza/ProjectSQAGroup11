#!/usr/bin/env python3

import json
import re
import subprocess
from pathlib import Path

RESULT = Path("AI2_GitHubCopilot/Result")
CURRENT_RUN = "run-copilot-final-v2"
TOTAL = 854

FINISHED = {
    "DONE",
    "INVALID_AFTER_REPAIR",
    "INVALID_AFTER_PROMPT04",
    "OUTPUT_INCOMPLETE",
}


def read_status(path):
    try:
        return json.loads(path.read_text()).get("status")
    except (OSError, ValueError):
        return None


def collect_results():
    current = {}
    historical = {}

    for case_dir in RESULT.iterdir():
        if not case_dir.is_dir():
            continue

        case = case_dir.name

        for run_dir in case_dir.glob("run-*"):
            if not run_dir.is_dir():
                continue

            status_file = run_dir / "case_status.json"

            if not status_file.exists():
                continue

            status = read_status(status_file)

            if run_dir.name == CURRENT_RUN:
                current[case] = status
            else:
                historical.setdefault(case, {})[
                    run_dir.name
                ] = status

    return current, historical


def main():
    # Read the existing monitor without changing its code.
    p = subprocess.run(
        [
            "python3",
            "Experiment/automation/monitor_c_short.py"
        ],
        capture_output=True,
        text=True
    )

    output = p.stdout

    if p.returncode:
        print(output)
        print(p.stderr)
        return

    # Keep only the worker status section.
    # The queue and quota sections are rebuilt below.
    lines = output.splitlines()
    worker_lines = []

    for line in lines:
        if (
            "QUEUE" in line
            or "COPILOT / DEEPSEEK ACCOUNT POOL" in line
            or "ACTUAL KKU API QUOTA" in line
        ):
            break

        worker_lines.append(line)

    print("\n".join(worker_lines))

    current, historical = collect_results()

    current_finished = {
        case
        for case, status in current.items()
        if status in FINISHED
    }

    historical_finished = {
        case
        for case, runs in historical.items()
        if any(s in FINISHED for s in runs.values())
    }

    combined = current_finished | historical_finished
    old_only = historical_finished - current_finished

    # Detect active case names from the worker table.
    active = set()

    for line in worker_lines:
        match = re.match(
            r"^(C\d+)\s+RUNNING\s+"
            r"([A-Za-z][A-Za-z0-9]*-\d+)\s+",
            line
        )

        if match:
            active.add(match.group(2))

    running = active - combined

    errors = {
        case
        for case, status in current.items()
        if status == "ERROR"
    } - combined - running

    quota = {
        case
        for case, status in current.items()
        if status == "QUOTA_PAUSED"
    } - combined - running

    waiting = max(
        0,
        TOTAL
        - len(combined)
        - len(running)
        - len(errors)
        - len(quota)
    )

    print()
    print("=" * 82)
    print("C QUEUE - CURRENT + PREVIOUS")
    print("=" * 82)

    print(f"Finished : {len(combined)}")
    print(f"  Current : {len(current_finished)}")
    print(f"  Old only: {len(old_only)}")
    print(f"Running  : {len(running)}")
    print(f"Error    : {len(errors)}")
    print(f"Quota    : {len(quota)}")
    print(f"Waiting  : {waiting}")

    print()
    print("Finished counts distinct cases, including previous runs.")
    print("Different runs may have used different prompts.")

    # Existing account pool.
    subprocess.run(
        [
            "python3",
            "Experiment/automation/pool_status_short.py",
            "C",
        ],
        check=False,
    )

    # Cached actual API quota.
    # Does not make an API request on every refresh.
    subprocess.run(
        [
            "python3",
            "Experiment/automation/c_quota_cache.py",
            "--show",
        ],
        check=False,
    )


if __name__ == "__main__":
    main()
